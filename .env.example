# ── Backend / Azure Function ──────────────────────────────────────────────────

# Azure Cognitive Services (TTS)
AZURE_SPEECH_KEY=your_speech_key_here
AZURE_SPEECH_REGION=eastus

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_CONTAINER=reminders

# Azure SQL (pyodbc connection string)
# Example: mssql+pyodbc://user:pass@server.database.windows.net/dbname?driver=ODBC+Driver+18+for+SQL+Server
DATABASE_URL=mssql+pyodbc://...

# JWT
JWT_SECRET=change_me_to_a_long_random_string

# Firebase (paste full service account JSON as a single-line string)
FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# ── Mobile ────────────────────────────────────────────────────────────────────
# Create mobile/.env with:
EXPO_PUBLIC_API_URL=https://your-app-service.azurewebsites.net
